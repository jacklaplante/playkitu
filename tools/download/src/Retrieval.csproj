<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Playkitu.Retrieval</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Browser.html" LogicalName="Playkitu.Retrieval.Browser.html" />
    <EmbeddedResource Include="../../../docs/assets/playkitu.png" LogicalName="Playkitu.Logo.png" />
    <Compile Include="../../../packages/com.playkitu.recording/Client/RecordingSchedulingMath.cs" Link="Shared/RecordingSchedulingMath.cs" />
    <ProjectReference Include="../../../backend/issuer/src/Issuer.csproj" />
    <PackageReference Include="AWSSDK.Core" Version="[4.0.102.11]" />
    <PackageReference Include="AWSSDK.KinesisVideo" Version="[4.0.100.19]" />
    <PackageReference Include="AWSSDK.KinesisVideoArchivedMedia" Version="[4.0.100.19]" />
  </ItemGroup>
</Project>
