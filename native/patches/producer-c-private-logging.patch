+// Playreel per-owner policy override before Kinesis client creation/requests.
+// The C++ factory passes the original callback owner, never a request or global.
+STATUS sbrecConfigureSender(PClientCallbacks client, UINT32 rate,UINT32 capacity,UINT32 quantum,UINT32 wait,UINT32 slice) {
+    PCallbacksProvider provider=(PCallbacksProvider)client;PCurlApiCallbacks curl=NULL;UINT32 i;
+    LARGE_INTEGER now,frequency;SbrecSenderConfig config={rate,capacity,quantum,wait,slice};
+    if(!provider || provider->clientCallbacks.customData!=(UINT64)provider)return STATUS_INVALID_ARG;
+    if(!QueryPerformanceCounter(&now)||!QueryPerformanceFrequency(&frequency)||
+       !sbrecSenderConfigValid(config,(uint64_t)frequency.QuadPart))return STATUS_INVALID_ARG;
+    for(i=0;i<provider->apiCallbacksCount;i++)
+        if(provider->pApiCallbacks[i].freeApiCallbacksFn==freeApiCallbacksCurl){
+            curl=(PCurlApiCallbacks)provider->pApiCallbacks[i].customData;break;
+        }
+    if(!curl || curl->streamingRequestCount || curl->senderPacer.granted || curl->senderPacer.waiters)return STATUS_INVALID_OPERATION;
+    return sbrecSenderInit(&curl->senderPacer,config,(uint64_t)now.QuadPart,(uint64_t)frequency.QuadPart)?STATUS_SUCCESS:STATUS_INVALID_ARG;
+}
diff --git a/src/source/SbrecSenderPacing.h b/src/source/SbrecSenderPacing.h
new file mode 100644
--- /dev/null
+++ b/src/source/SbrecSenderPacing.h
@@ -0,0 +1,100 @@
+#ifndef SBREC_SENDER_PACING_H
+#define SBREC_SENDER_PACING_H
+/* Playreel PutMedia payload pacing: internal SDK state, not the runner ABI.
+ * One owner covers concurrent/replacement uploads. No producer lock is held
+ * while waiting. Profile: media288KiB/s + logs32KiB/s + reserve64KiB/s.
+ * Logs allow a separate256KiB POST burst. None of this is a true wire cap. */
+#include <windows.h>
+#include <stdint.h>
+/* Optional compiler definitions configure this SDK build without a runner ABI change. */
+#ifndef SBREC_MEDIA_BPS
+#define SBREC_MEDIA_BPS (288u*1024u)
+#endif
+#ifndef SBREC_MEDIA_CREDIT
+#define SBREC_MEDIA_CREDIT 4096u
+#endif
+#ifndef SBREC_MEDIA_QUANTUM
+#define SBREC_MEDIA_QUANTUM 4096u
+#endif
+#ifndef SBREC_MEDIA_WAIT_MS
+#define SBREC_MEDIA_WAIT_MS 100u
+#endif
+#ifndef SBREC_MEDIA_SLICE_MS
+#define SBREC_MEDIA_SLICE_MS 2u
+#endif
+typedef struct { uint32_t bytesPerSecond,capacityBytes,readBytes,maximumWaitMs,sliceMs; } SbrecSenderConfig;
+typedef struct {
+    SRWLOCK lock;
+    SbrecSenderConfig config;
+    uint64_t last,frequency,remainder;
+    uint32_t credit,reserved;
+    volatile LONG waiters;
+    volatile LONG64 waits,cancelled,timeouts;
+    uint64_t granted,refunded,used;
+} SbrecSenderPacer;
+static __inline SbrecSenderConfig sbrecSenderDefaults(void) {
+    SbrecSenderConfig c={SBREC_MEDIA_BPS,SBREC_MEDIA_CREDIT,SBREC_MEDIA_QUANTUM,SBREC_MEDIA_WAIT_MS,SBREC_MEDIA_SLICE_MS};return c;
+}
+static __inline int sbrecSenderConfigValid(SbrecSenderConfig c,uint64_t frequency) {
+    if(!frequency || frequency>1000000000000ULL ||
+       c.bytesPerSecond<65536 || c.bytesPerSecond>4u*1024u*1024u ||
+       c.capacityBytes<512 || c.capacityBytes>16384 || c.readBytes<512 ||
+       c.readBytes>4096 || c.readBytes>c.capacityBytes || c.maximumWaitMs<20 ||
+       c.maximumWaitMs>100 || !c.sliceMs || c.sliceMs>5 || (uint64_t)c.readBytes*1000>(uint64_t)c.bytesPerSecond*(c.maximumWaitMs-c.sliceMs)) return 0;
+    return 1;
+}
+static __inline int sbrecSenderInit(SbrecSenderPacer* p,SbrecSenderConfig c,uint64_t now,uint64_t frequency) {
+    if(!p || !sbrecSenderConfigValid(c,frequency))return 0;
+    ZeroMemory(p,sizeof(*p));InitializeSRWLock(&p->lock);
+    p->config=c;p->last=now;p->frequency=frequency;return 1;
+}
+/* Called under the short accounting lock. Outstanding reads occupy capacity:
+ * idle time during a slow SDK read cannot become credit for another attempt. */
+static __inline int sbrecSenderRefill(SbrecSenderPacer* p,uint64_t now) {
+    uint64_t elapsed,add,numerator;uint32_t ceiling=p->config.capacityBytes-p->reserved;
+    /* Concurrent callers may sample QPC before taking this lock in reverse order. */
+    if(now<p->last)now=p->last;
+    elapsed=now-p->last;p->last=now;
+    if(elapsed>=p->frequency){p->credit=ceiling;p->remainder=0;}
+    else {
+        numerator=elapsed*p->config.bytesPerSecond+p->remainder;
+        add=numerator/p->frequency;p->remainder=numerator%p->frequency;
+        if(add>=ceiling-p->credit){p->credit=ceiling;p->remainder=0;}
+        else p->credit+=(uint32_t)add;
+    }
+    return 1;
+}
+static __inline int sbrecSenderReserve(SbrecSenderPacer* p,uint64_t now,uint32_t requested,uint32_t* grant) {
+    uint32_t n=requested<p->config.readBytes?requested:p->config.readBytes;int valid;
+    *grant=0;AcquireSRWLockExclusive(&p->lock);valid=sbrecSenderRefill(p,now);
+    if(valid && n && p->credit>=n){*grant=n;p->credit-=n;p->reserved+=n;p->granted+=n;}
+    ReleaseSRWLockExclusive(&p->lock);return valid;
+}
+static __inline int sbrecSenderFinish(SbrecSenderPacer* p,uint64_t now,uint32_t reserved,uint32_t used) {
+    int valid;uint32_t unused;
+    AcquireSRWLockExclusive(&p->lock);
+    valid=reserved<=p->reserved && used<=reserved && sbrecSenderRefill(p,now);
+    if(valid){unused=reserved-used;p->reserved-=reserved;p->credit+=unused;p->refunded+=unused;p->used+=used;}
+    ReleaseSRWLockExclusive(&p->lock);return valid;
+}
+/* Only curl/SDK transport threads call this bounded wait. The cancellation
+ * function reads request atomics; no Unity, socket, SDK producer or allocation. */
+static __inline int sbrecSenderAcquire(SbrecSenderPacer* p,uint32_t requested,
+                                      int (*cancel)(void*),void* context,uint32_t* grant) {
+    LARGE_INTEGER start,now;int waiting=0,result=0;
+    QueryPerformanceCounter(&start);*grant=0;
+    for(;;){
+        if(cancel(context)){InterlockedIncrement64(&p->cancelled);break;}
+        QueryPerformanceCounter(&now);
+        if(!sbrecSenderReserve(p,(uint64_t)now.QuadPart,requested,grant))break;
+        if(*grant){result=1;break;}
+        if((uint64_t)(now.QuadPart-start.QuadPart)*1000>=p->frequency*p->config.maximumWaitMs){
+            InterlockedIncrement64(&p->timeouts);break;
+        }
+        if(!waiting){waiting=1;InterlockedIncrement(&p->waiters);InterlockedIncrement64(&p->waits);}
+        Sleep(p->config.sliceMs);
+    }
+    if(waiting)InterlockedDecrement(&p->waiters);
+    return result;
+}
+#endif
